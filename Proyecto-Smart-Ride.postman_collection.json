					"name": "login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Verifica que la solicitud haya sido exitosa (código 200)",
									"if (pm.response.code === 200) {",
									"    // 1. Parsea el cuerpo JSON de la respuesta",
									"    var jsonData = pm.response.json();",
									"    ",
									"    // 2. Extrae el valor del campo \"access_token\"",
									"    var token = jsonData.access_token;",
									"    ",
									"    // 3. ¡CORRECCIÓN! Guarda el token en la variable de ENTORNO 'token-acceso'",
									"    // Usa 'pm.globals.set' si 'token-acceso' es global, o 'pm.environment.set' si es de entorno.",
									"    pm.environment.set(\"token-acceso\", token); // Cambiar \"token\" a \"token-acceso\"",
									"    ",
									"    // Opcional: Muestra un mensaje en la Consola de Postman para confirmar",
									"    console.log(\"Nuevo token guardado en la variable: \" + token);",
									"} else {",
									"    console.error(\"Fallo de login. No se pudo obtener el token.\");",
									"}"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
